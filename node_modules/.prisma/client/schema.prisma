generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  REVIEW
  REVISION
  APPROVED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  COMPLETED
  TRANSFERRED
  RETURNED
  CANCELLED
}

enum WorkflowEventType {
  CREATED
  ASSIGNED
  ACCEPTED
  STARTED
  COMPLETED
  TRANSFERRED
  RETURNED
  APPROVED
  REJECTED
  CANCELLED
  TASKS_GENERATED
  OVERRIDDEN
}

enum TaskType {
  GENERIC
  GRAPHIC
  REEL
  POST
  VIDEO
  CONTENT
}

model Company {
  id          String        @id @default(cuid())
  companyName String
  companyCode String        @unique
  email       String
  phone       String?
  website     String?
  logo        String?
  industry    String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  timezone    String?
  currency    String?
  gstNumber   String?
  panNumber   String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users       User[]
  roles       Role[]
  departments Department[]

  @@map("companies")
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("departments")
}

model Workflow {
  id                  String               @id @default(cuid())
  companyId           String
  subjectType         String
  subjectId           String
  title               String
  status              WorkflowStatus       @default(PENDING)
  currentStageKey     String?
  currentDepartmentId String?
  version             Int                  @default(1)
  startedAt           DateTime?
  completedAt         DateTime?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assignments         WorkflowAssignment[]
  history             WorkflowHistory[]
  tasks               Task[]

  @@unique([companyId, subjectType, subjectId])
  @@index([companyId, status, currentDepartmentId])
  @@map("workflows")
}

model WorkflowAssignment {
  id           String           @id @default(cuid())
  workflowId   String
  companyId    String
  departmentId String
  assignedById String
  assignedToId String
  remarks      String?
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  completedAt  DateTime?
  closedAt     DateTime?
  workflow     Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([companyId, assignedToId, status, assignedAt])
  @@index([workflowId, assignedAt])
  @@map("workflow_assignments")
}

model WorkflowHistory {
  id           String            @id @default(cuid())
  workflowId   String
  companyId    String
  eventType    WorkflowEventType
  actorId      String
  fromStatus   WorkflowStatus?
  toStatus     WorkflowStatus?
  fromUserId   String?
  toUserId     String?
  departmentId String?
  remarks      String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@map("workflow_history")
}

model Task {
  id           String           @id @default(cuid())
  workflowId   String
  companyId    String
  title        String
  type         TaskType         @default(GENERIC)
  status       WorkflowStatus   @default(PENDING)
  assignedToId String?
  createdById  String
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  workflow     Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  comments     TaskComment[]
  attachments  TaskAttachment[]

  @@index([companyId, assignedToId, status])
  @@index([workflowId, status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  companyId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  companyId    String
  uploadedById String
  fileName     String
  fileUrl      String
  mimeType     String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_attachments")
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String?
  email     String  @unique
  phone     String? @unique
  password  String

  profileImage String?
  designation  String?
  department   String?

  roleId String
  role   Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status UserStatus @default(ACTIVE)

  lastLogin    DateTime?
  refreshToken String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  users        User[]
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      String
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}
