generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  REVIEW
  REVISION
  APPROVED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  COMPLETED
  TRANSFERRED
  RETURNED
  CANCELLED
}

enum WorkflowEventType {
  CREATED
  ASSIGNED
  ACCEPTED
  STARTED
  COMPLETED
  TRANSFERRED
  RETURNED
  APPROVED
  REJECTED
  CANCELLED
  TASKS_GENERATED
  OVERRIDDEN
}

enum TaskType {
  GENERIC
  GRAPHIC
  REEL
  POST
  VIDEO
  CONTENT
}

enum AssignmentStrategy {
  ROUND_ROBIN
  LEAST_WORKLOAD
  MANUAL_OVERRIDE
}

model Company {
  id          String        @id @default(cuid())
  companyName String
  companyCode String        @unique
  email       String
  phone       String?
  website     String?
  logo        String?
  industry    String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  timezone    String?
  currency    String?
  gstNumber   String?
  panNumber   String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users           User[]
  roles           Role[]
  departments     Department[]
  chatMessages    ChatMessage[]
  leads           Lead[]
  clients         Client[]
  services        Service[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  announcements   Announcement[]
  workflowSetting WorkflowSetting?

  @@map("companies")
}

model Department {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
  users     User[]
  tasks     Task[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("departments")
}

model Workflow {
  id                  String               @id @default(cuid())
  companyId           String
  subjectType         String
  subjectId           String
  title               String
  status              WorkflowStatus       @default(PENDING)
  currentStageKey     String?
  currentDepartmentId String?
  version             Int                  @default(1)
  isAutoGenerated     Boolean              @default(false)
  metadata            Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assignments         WorkflowAssignment[]
  history             WorkflowHistory[]
  tasks               Task[]

  @@unique([companyId, subjectType, subjectId])
  @@index([companyId, status, currentDepartmentId])
  @@map("workflows")
}

model WorkflowAssignment {
  id           String           @id @default(cuid())
  workflowId   String
  companyId    String
  departmentId String
  assignedById String
  assignedToId String
  remarks      String?
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  completedAt  DateTime?
  closedAt     DateTime?
  workflow     Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([companyId, assignedToId, status, assignedAt])
  @@index([workflowId, assignedAt])
  @@map("workflow_assignments")
}

model WorkflowHistory {
  id           String            @id @default(cuid())
  workflowId   String
  companyId    String
  eventType    WorkflowEventType
  actorId      String
  fromStatus   WorkflowStatus?
  toStatus     WorkflowStatus?
  fromUserId   String?
  toUserId     String?
  departmentId String?
  remarks      String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@map("workflow_history")
}

model Task {
  id                 String           @id @default(cuid())
  workflowId         String
  companyId          String
  title              String
  type               TaskType         @default(GENERIC)
  serviceId          String?
  serviceName        String?
  departmentId       String?
  priority           String           @default("MEDIUM")
  dueDate            DateTime?
  description        String?
  isCustom           Boolean          @default(false)
  templateKey        String?
  dependsOnTaskId    String?
  isLocked           Boolean          @default(false)
  status             WorkflowStatus   @default(PENDING)
  assignedToId       String?
  createdById        String
  completedAt        DateTime?
  publishedPlatforms String[]         @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  workflow           Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTo         User?            @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments           TaskComment[]
  attachments        TaskAttachment[]

  @@index([companyId, assignedToId, status])
  @@index([workflowId, serviceId])
  @@index([companyId, departmentId, status])
  @@index([workflowId, status])
  @@map("tasks")
}

model WorkflowSetting {
  id                 String             @id @default(cuid())
  companyId          String             @unique
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignmentStrategy AssignmentStrategy @default(LEAST_WORKLOAD)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("workflow_settings")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  companyId String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  companyId    String
  uploadedById String
  fileName     String
  fileUrl      String
  mimeType     String?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_attachments")
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String?
  email     String  @unique
  phone     String? @unique
  password  String

  profileImage  String?
  designation   String?
  department    String?
  departmentId  String?
  departmentRef Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roleId String
  role   Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status UserStatus @default(ACTIVE)

  lastLogin    DateTime?
  refreshToken String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sentMessages  ChatMessage[]  @relation("SentMessages")
  assignedLeads Lead[]         @relation("AssignedLeads")
  ownedServices Service[]
  assignedTasks Task[]         @relation("AssignedTasks")
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@map("users")
}

model Role {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  users        User[]
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      String
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("chat_messages")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id               String     @id @default(cuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  source           String?
  status           LeadStatus @default(NEW)
  assignedToId     String?
  assignedTo       User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  value            Float?
  notes            String?
  subtitle         String?
  score            Int?       @default(70)
  intent           String?
  nextAction       String?
  aiRecommendation String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([companyId, status])
  @@map("leads")
}

model Client {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  email           String
  phone           String?
  website         String?
  address         String?
  notes           String?
  status          String    @default("ACTIVE")
  pausedAt        DateTime?
  pauseDays       Int?      @default(0)
  pauseReason     String?
  nextBillingDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  services ClientService[]

  @@index([companyId])
  @@map("clients")
}

model Service {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  taskType      TaskType    @default(GENERIC)
  ownerId       String?
  owner         User?       @relation(fields: [ownerId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  taskTemplates Json?

  clientLinks ClientService[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, departmentId])
  @@map("services")
}

model ClientService {
  clientId      String
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  configuration Json?

  @@id([clientId, serviceId])
  @@map("client_services")
}

model ActivityLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([companyId, userId, isRead, createdAt])
  @@map("notifications")
}

model Announcement {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  content     String
  eventDate   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, createdAt])
  @@map("announcements")
}
