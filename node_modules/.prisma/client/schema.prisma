generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES
  ACCOUNT_MANAGER
  DESIGNER
  SOCIAL_MEDIA_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id          String        @id @default(cuid())
  companyName String
  companyCode String        @unique
  email       String
  phone       String?
  website     String?
  logo        String?
  industry    String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  timezone    String?
  currency    String?
  gstNumber   String?
  panNumber   String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users User[]

  @@map("companies")
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String?
  email     String  @unique
  phone     String? @unique
  password  String

  profileImage String?
  designation  String?

  role   UserRole   @default(ADMIN)
  status UserStatus @default(ACTIVE)

  lastLogin    DateTime?
  refreshToken String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
